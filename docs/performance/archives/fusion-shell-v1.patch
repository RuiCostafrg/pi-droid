+/**
+ * Internal binary-to-file transport. stdout is streamed with backpressure, never
+ * decoded/trimmed/buffer-capped; maxBuffer still bounds diagnostic stderr. The
+ * caller owns partial-file removal, just as it did with adb pull.
+ */
+export async function adbToFile(args: string[], path: string, options: AdbExecOptions = {}): Promise<string> {
+  return executeAdb(args, options, async (fullArgs, { signal, maxBuffer }) => {
+    if (typeof maxBuffer !== "number" || Number.isNaN(maxBuffer) || maxBuffer < 0) throw new RangeError("Invalid ADB buffer limit");
+    const child = spawn("adb", fullArgs, { signal, stdio: ["ignore", "pipe", "pipe"] });
+    const chunks: Buffer[] = [];
+    let bytes = 0;
+    type ProcessFailure = Error & { code?: unknown; stderr?: string; signal?: string | null; killed?: boolean; failureKind?: ExecutionFailureKind };
+    let firstError: ProcessFailure | undefined;
+    const closed = new Promise<void>(resolve => {
+      // AbortError is emitted immediately even if a child ignores SIGTERM.
+      // The aborted pipeline settles disk writes; do not wait for remote/process
+      // termination that the existing cancellation contract never guaranteed.
+      child.on("error", error => { firstError ??= error; resolve(); });
+      child.stderr.on("data", (chunk: Buffer) => {
+        // Never retain unbounded stderr, including after a kill request.
+        const remaining = Math.max(0, maxBuffer - bytes);
+        if (remaining) chunks.push(chunk.subarray(0, remaining));
+        bytes += chunk.length;
+        if (bytes > maxBuffer && !firstError) {
+          firstError = Object.assign(new Error("ADB stderr buffer exceeded"), { code: "ERR_CHILD_PROCESS_STDIO_MAXBUFFER" });
+          child.kill();
+        }
+      });
+      child.on("close", (code, exitSignal) => {
+        if (code !== 0 && !firstError) firstError = Object.assign(new Error("ADB process failed"), {
+          code, signal: exitSignal, killed: child.killed,
+        });
+        resolve();
+      });
+    });
+    const transferred = pipeline(child.stdout, createWriteStream(path), { signal }).catch(error => {
+      if (!firstError) firstError = Object.assign(error, { failureKind: "unknown" as const });
+      child.kill();
+    });
+    await Promise.all([closed, transferred]);
+    const stderr = Buffer.concat(chunks).toString("utf8");
+    if (firstError) {
+      firstError.stderr = stderr;
+      firstError.killed = child.killed;
+      throw firstError;
+    }
+    return stderr;
+  });
+}
