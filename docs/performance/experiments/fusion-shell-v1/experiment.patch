+ if(mode==='transfer'){process.stdout.write('PARTIAL');process.stderr.write('PRIVATE_ERROR');process.exit(7);}
+ process.stdout.write(fs.readFileSync(remote(name)));
+ const cleanup=mode==='cleanup'||mode==='both-cleanups'?1:0;
+ if(!cleanup)fs.rmSync(remote(name),{force:true});
+ if(mode!=='missing-ack')process.stdout.write('\\n'+token+':'+(mode==='legacy-exit'?7:mode==='invalid-status'?999:0)+':'+cleanup+'\\n');
+}else if(c.startsWith('shell rm -f ')){
+ if(mode==='both-cleanups'){process.stderr.write('PRIVATE_ERROR');process.exit(8);}
