+import { afterEach, beforeEach, expect, it } from "vitest";
+import { mkdtemp, writeFile, chmod, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { execFile } from "node:child_process";
+import { promisify } from "node:util";
+const exec = promisify(execFile);
+let dir: string;
+beforeEach(async () => {
+  dir = await mkdtemp(join(tmpdir(), "fusion-transfer-"));
+  await writeFile(join(dir, "adb"), `#!${process.execPath}
+const mode=process.env.FUSION_MODE;
+if(mode==='timeout-ignores'){require('node:fs').writeFileSync(process.env.FUSION_PID,String(process.pid));process.on('SIGTERM',()=>{});setInterval(()=>{},1000);}
+else if(mode==='timeout')setInterval(()=>{},1000);
+else if(mode==='exit'){process.stderr.write('PRIVATE_ERROR');process.exit(7);}
