@@ -137,0 +138,58 @@ export async function adb(args: string[], options: AdbExecOptions = {}): Promise
+/** Execute a text command; preserves the existing trim/buffer contract. */
+export async function adb(args: string[], options: AdbExecOptions = {}): Promise<string> {
+  return executeAdb(args, options, async (fullArgs, processOptions) => {
+    const { stdout } = await execAsync("adb", fullArgs, { timeout: 0, ...processOptions });
+    return stdout.trim();
+  });
+}
